{
  "buildCommand": "cd backEnd && npm install && cd ../frontEnd && npm install && npm run build",
  "outputDirectory": "frontEnd/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}