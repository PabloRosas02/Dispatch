{
  "buildCommand": "cd backEnd && npm install && npx tsc && cd ../frontEnd && npm install && npm run build",
  "outputDirectory": "frontEnd/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "backEnd/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}